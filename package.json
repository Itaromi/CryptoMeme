{
  "name": "cryptomeme",
  "description": "Jeu de trading multijoueur de cryptos et d'actions 100 % fictives",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Itaromi/CryptoMeme.git"
  },
  "homepage": "https://cryptomeme.younsylvestre.fr",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.19.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "db:up": "docker compose up -d",
    "db:migrate": "pnpm --filter @cryptomeme/api prisma:migrate",
    "db:seed": "pnpm --filter @cryptomeme/api prisma:seed"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.8.3"
  }
}
