{
  "name": "cryptomeme",
  "private": true,
  "packageManager": "pnpm@10.19.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "db:up": "docker compose up -d",
    "db:migrate": "pnpm --filter @cryptomeme/api prisma:migrate",
    "db:seed": "pnpm --filter @cryptomeme/api prisma:seed"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.8.3"
  }
}
