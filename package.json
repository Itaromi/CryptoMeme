{
  "name": "cryptomeme",
  "description": "Jeu de trading multijoueur de cryptos et d'actions 100 % fictives",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Itaromi/CryptoMeme.git"
  },
  "homepage": "https://cryptomeme.younsylvestre.fr",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.19.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "db:up": "docker compose up -d",
    "db:migrate": "pnpm --filter @cryptomeme/api prisma:migrate",
    "db:seed": "pnpm --filter @cryptomeme/api prisma:seed",
    "lint": "turbo run build --filter=@cryptomeme/shared --filter=@cryptomeme/engine --output-logs=errors-only && eslint .",
    "lint:fix": "turbo run build --filter=@cryptomeme/shared --filter=@cryptomeme/engine --output-logs=errors-only && eslint . --fix"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "16.4.6",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "turbo": "^2.11.11",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0"
  }
}
