# Point d'entrée unique de CryptoMeme. Le HTTPS est géré en amont (tunnel Cloudflare),
# Caddy écoute donc en HTTP sur le réseau local et répartit le trafic.
{
	admin off
	servers {
		# Le tunnel cloudflared se trouve sur le réseau local / Docker
		trusted_proxies static private_ranges
	}
}

:80 {
	encode zstd gzip

	# API REST et WebSocket temps réel
	@api path /api/* /socket.io/*
	handle @api {
		reverse_proxy api:4000
	}

	# Site Next.js
	handle {
		reverse_proxy web:3000
	}

	header -Server
	log {
		output stdout
		format console
	}
}
