# CryptoMeme — configuration de production. Copie ce fichier en .env (jamais commité).
# Génère les secrets avec :  openssl rand -base64 48

# URL publique du jeu (https obligatoire en production)
WEB_URL=https://cryptomeme.example.com

# Secrets
POSTGRES_PASSWORD=
JWT_SECRET=

# E-mails transactionnels (https://resend.com) : clé API + expéditeur sur un domaine vérifié chez Resend
RESEND_API_KEY=
MAIL_FROM="CryptoMeme <no-reply@example.com>"

# Derrière un tunnel Cloudflare : l'IP réelle des joueurs vient de CF-Connecting-IP
TRUST_CLOUDFLARE=true

# Port exposé par Caddy sur la machine hôte (le tunnel pointe dessus)
HTTP_PORT=8088

# Compte admin créé par le seed (14 caractères minimum en production)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Images : publiées par la CI sur GHCR, ou construites localement (--build)
# API_IMAGE=ghcr.io/itaromi/cryptomeme-api:latest
# WEB_IMAGE=ghcr.io/itaromi/cryptomeme-web:latest
